      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "signature_status": {
          "name": "signature_status",
          "value": "\"signatures\".\"status\" IN ('pending','public','rejected','deleted')"
        },
        "signature_kind": {
          "name": "signature_kind",
          "value": "\"signatures\".\"kind\" IN ('visitor','event-card-import')"
        },
        "signature_review": {
          "name": "signature_review",
          "value": "\"signatures\".\"review_status\" IN ('not-required','pending','approved','rejected')"
        },
        "signature_style": {
          "name": "signature_style",
          "value": "\"signatures\".\"font\" IN ('caveat','dancing','kalam') AND \"signatures\".\"ink\" IN ('#252822','#355b93','#5f7143','#86516d')"
        },
        "signature_bounds": {
          "name": "signature_bounds",
          "value": "\"signatures\".\"x\" >= 0 AND \"signatures\".\"y\" >= 0 AND \"signatures\".\"width\" > 0 AND \"signatures\".\"height\" > 0 AND \"signatures\".\"x\"+\"signatures\".\"width\" <= 1 AND \"signatures\".\"y\"+\"signatures\".\"height\" <= 1"
        },
        "signature_json": {
          "name": "signature_json",
          "value": "json_valid(\"signatures\".\"socials\") AND json_valid(\"signatures\".\"provenance\")"
        },
        "import_source_required": {
          "name": "import_source_required",
          "value": "\"signatures\".\"kind\" != 'event-card-import' OR \"signatures\".\"source_card_id\" IS NOT NULL"
        },
        "review_before_public": {
          "name": "review_before_public",
          "value": "\"signatures\".\"status\" != 'public' OR (\"signatures\".\"kind\" = 'visitor' AND \"signatures\".\"consented_at\" IS NOT NULL) OR (\"signatures\".\"kind\" = 'event-card-import' AND \"signatures\".\"review_status\" = 'approved' AND \"signatures\".\"consented_at\" IS NOT NULL)"
        }
      }
